        },
        "ds:hasAerosolModelComponent": {
          "@id": "#Component.CNRM_ALADIN63_v2_AerosolModel",
          "@type": "ds:AerosolModel",
          "rdfs:label": "CNRM_ALADIN63_v2_AerosolModel",
          "ds:aerosolMisc": "TACTIC dataset for eval and GCM forcing for scen, 5 classes, 2D spatial pattern, vertical profile, seasonal cycle, temporal evolution",
          "ds:aerosolParameterizationDescription": "prescribed"
        },
        "ds:hasAtmosModelComponent": {
          "@id": "#Component.CNRM_ALADIN63_v2_AtmosphericModel",
          "@type": "ds:AtmosModel",
          "rdfs:label": "CNRM_ALADIN63_v2_AtmosphericModel",
          "ds:gridDescription": "Lambert conformal conic projection, hybrid sigma-pressure for the vertical",
          "ds:atmosMisc": "Air–sea turbulent fluxes are derived from the ECUME (Exchange Coefficients from Unified Multi-campaigns Estimates) iterative approach (Belamari and Pirani, 2007)",
