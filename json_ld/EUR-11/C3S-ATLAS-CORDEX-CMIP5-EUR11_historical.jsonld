        "@id": "cx5m:SMHI-RCA4-EUR-11-v1a",
        "@type": "ds:RCM",
        "rdfs:label": "RCA4",
        "ds:simulationNotes": "Model versions: i) v1a is simply a re-run because a restart file to start the scenario experiment was taken from another simulations, ii) v2 and v3 are slightly tuned versions of v1 (some parameters) but parameterizations are the same. SN indicates spectral nudging. ",
        "ds:versionTag": "v1a",
        "ds:hasLakeModelComponent": {
          "@id": "#Component.SMHI_RCA4_v1a_LakeModel",
          "@type": "ds:LakeModel",
          "rdfs:label": "SMHI_RCA4_v1a_LakeModel",
          "ds:lakeRepresentation": "Flake (Mironov et al., 2010) pronostic lake ice"
        },
        "ds:hasOceanModelComponent": {
          "@id": "#Component.SMHI_RCA4_v1a_OceanModel",
          "@type": "ds:OceanModel",
          "rdfs:label": "SMHI_RCA4_v1a_OceanModel",
          "ds:oceanMisc": "daily update from driving GCM/reanalysis",
          "ds:oceanRepresentationMode": "Prescribed SST and SI"
        },
        "ds:hasLandSurfaceModelComponent": {
          "@id": "#Component.SMHI_RCA4_v1a_LandSurfaceModel",
          "@type": "ds:LandSurfaceModel",
          "rdfs:label": "SMHI_RCA4_v1a_LandSurfaceModel",
          "ds:lsmLevels": "3",
          "ds:lsmComponentName": "a tile-based scheme with physiography based on ECOCLIMAP (Samuelsson et al. 2015)"
        },
        "ds:hasAerosolModelComponent": {
          "@id": "#Component.SMHI_RCA4_v1a_AerosolModel",
          "@type": "ds:AerosolModel",
          "rdfs:label": "SMHI_RCA4_v1a_AerosolModel",
          "ds:aerosolMisc": "Single integrated class, parameterized aerosol effect on radiation fluxes,spatially uniform, static",
          "ds:aerosolParameterizationDescription": "prescribed"
        },
        "ds:hasAtmosModelComponent": {
          "@id": "#Component.SMHI_RCA4_v1a_AtmosphericModel",
          "@type": "ds:AtmosModel",
          "rdfs:label": "SMHI_RCA4_v1a_AtmosphericModel",
          "ds:atmosShortwaveRadiationScheme": "Savijärvi (1990) and Sass et al. (1994) with the consideration of CO2 absorption and an improved treatment of the water vapour continuum (Räisänen et al.,2000)",
          "ds:atmosLongwaveRadiationScheme": "Savijärvi (1990) and Sass et al. (1994) with the consideration of CO2 absorption and an improved treatment of the water vapour continuum (Räisänen et al.,2000)",
          "ds:atmosMicrophysicsScheme": "Rasch and Kristjansson (1998)",
          "ds:atmosPblScheme": "TKE scheme (Lenderink and Holtslag, 2004)",
          "ds:atmosConvectionScheme": "based on Bechtold-Kain-Fritsch (BKF) scheme (Bechtold et al., 2001) with revised calculation of CAPE profile according to Jiao and Jones (2008)",
          "ds:toaLevels": "40"
        },
