          "@id": "#Component.GERICS_REMO2015_v1_LandSurfaceModel",
          "@type": "ds:LandSurfaceModel",
          "rdfs:label": "GERICS_REMO2015_v1_LandSurfaceModel",
          "ds:lsmMisc": "a tile-based scheme including annual cycle of albedo",
