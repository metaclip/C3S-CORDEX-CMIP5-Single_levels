        "@type": "ds:RCM",
        "rdfs:label": "RACMO22E",
        "ds:simulationNotes": "Model versions: Simulations with RACMO22E_v2 are straight reruns of RACMO22E_v1 employing the same model system and parameter settings. Meaning of v2 depends on forcing GCM: i) MOHC-HadGEM2-ES: remapping of GCM-SST to RACMO grid erroneous in v1, corrected in v2 ii) CNRM-CERFACS-CNRM-CM5:Atmospheric forcings derived from pressure level fields, because of error in CNRM-CM5 model level fields",
        "ds:versionTag": "v2",
        "ds:hasDrivingGCM": [
          {
            "@id": "ipcc:HadGEM2-ES"
          },
          {
            "@id": "ipcc:CNRM-CM5"
          }
