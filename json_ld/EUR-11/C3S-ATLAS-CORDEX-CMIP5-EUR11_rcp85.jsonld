          "@type": "ds:AerosolModel",
          "rdfs:label": "KNMI_RACMO22E_v2_AerosolModel",
          "ds:aerosolMisc": "inferred from CAM inventory (except volcanic); historical and RCP pathways (van Vuuren et al., 2011; Lamarque et al., 2010; 2011); also used in evaluation Sulfate, particulate organic matter black carbon, sea salt, desert dust stratospheric aerosols, volcanic aerosol. Spatial maps and vertical profiles per species. Monthly variations and decadal trends. ",
          "ds:aerosolParameterizationDescription": "prescribed"
        },
        "ds:hasAtmosModelComponent": {
          "@id": "#Component.KNMI_RACMO22E_v2_AtmosphericModel",
          "@type": "ds:AtmosModel",
          "rdfs:label": "KNMI_RACMO22E_v2_AtmosphericModel",
          "ds:atmosMisc": "Baseline physics is taken from the IFS CY31r1 ECMWF package of physical parameterizations. MODIS inferred leaf-area index.",
