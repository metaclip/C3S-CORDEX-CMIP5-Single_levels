        "rdfs:label": "ALADIN63",
        "ds:simulationNotes": "ALADIN63 v1 and v2 are identical. v2 indicates that the runs driven by the CNRM-CM5 GCM use the corrected version of the CNRM-CM5 Atmospheric-LBCs contrary to ALADIN53_v1",
        "ds:versionTag": "v2",
        "ds:hasUrbanLandSurfaceModelComponent": {
          "@id": "#Component.CNRM_ALADIN63_v2_UrbanModel",
          "@type": "ds:UrbanLandSurfaceModel",
          "rdfs:label": "CNRM_ALADIN63_v2_UrbanModel",
          "ds:urbanLsmRepresentation": "Urban areas are considered as rock (Daniel et al. 2019)"
        },
        "ds:hasLakeModelComponent": {
          "@id": "#Component.CNRM_ALADIN63_v2_LakeModel",
          "@type": "ds:LakeModel",
          "rdfs:label": "CNRM_ALADIN63_v2_LakeModel",
          "ds:lakeRepresentation": "Flake (Moigne et al. (2016)), pronostic lake ice."
        },
        "ds:hasOceanModelComponent": {
          "@id": "#Component.CNRM_ALADIN63_v2_OceanModel",
          "@type": "ds:OceanModel",
          "rdfs:label": "CNRM_ALADIN63_v2_OceanModel",
          "ds:oceanMisc": "Ice cover defined by a SST threshold",
          "ds:oceanRepresentationMode": "Prescribed SST"
        },
        "ds:hasLandSurfaceModelComponent": {
          "@id": "#Component.CNRM_ALADIN63_v2_LandSurfaceModel",
          "@type": "ds:LandSurfaceModel",
          "rdfs:label": "CNRM_ALADIN63_v2_LandSurfaceModel",
          "ds:lsmMisc": "No land use land cover change is taken into account",
          "ds:lsmLevels": "14",
          "ds:lsmComponentName": "SURFEX8-ISBA (Decharme et al., 2019)"
        },
        "ds:hasAerosolModelComponent": {
          "@id": "#Component.CNRM_ALADIN63_v2_AerosolModel",
          "@type": "ds:AerosolModel",
          "rdfs:label": "CNRM_ALADIN63_v2_AerosolModel",
          "ds:aerosolMisc": "TACTIC dataset for eval and GCM forcing for scen, 5 classes, 2D spatial pattern, vertical profile, seasonal cycle, temporal evolution",
          "ds:aerosolParameterizationDescription": "prescribed"
        },
        "ds:hasAtmosModelComponent": {
          "@id": "#Component.CNRM_ALADIN63_v2_AtmosphericModel",
          "@type": "ds:AtmosModel",
          "rdfs:label": "CNRM_ALADIN63_v2_AtmosphericModel",
          "ds:gridDescription": "Lambert conformal conic projection, hybrid sigma-pressure for the vertical",
          "ds:atmosMisc": "Air–sea turbulent fluxes are derived from the ECUME (Exchange Coefficients from Unified Multi-campaigns Estimates) iterative approach (Belamari and Pirani, 2007)",
          "ds:atmosShortwaveRadiationScheme": "Fouquart and Bonnel (1980) , Morcrette et al. (2008)",
          "ds:atmosLongwaveRadiationScheme": "based on RRTM (Mlawer et al., 1997)",
          "ds:atmosMicrophysicsScheme": "Lopez (2002)",
          "ds:atmosPblScheme": "Cuxart et al. (2000)",
          "ds:atmosConvectionScheme": "PCMT; Piriou et al. (2007) and Guérémy (2011)",
          "ds:atmosDynamicsCore": "Dynamics is computed in the equivalent spectral space using bi-Fourier transforms. Two-time-level semi-Lagrangian semi-implicit numerical integration scheme",
          "ds:toaLevels": "91 (0.01 hPa, ~75 km)"
        },
