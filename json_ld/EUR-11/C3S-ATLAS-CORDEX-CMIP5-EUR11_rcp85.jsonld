          "@type": "ds:OceanModel",
          "rdfs:label": "KNMI_RACMO22E_v2_OceanModel",
          "ds:oceanRepresentationMode": "prescribed SST and SI concentration; inferred from from reanalysis or GCM"
        },
        "ds:hasLandSurfaceModelComponent": {
          "@id": "#Component.KNMI_RACMO22E_v2_LandSurfaceModel",
          "@type": "ds:LandSurfaceModel",
          "rdfs:label": "KNMI_RACMO22E_v2_LandSurfaceModel",
          "ds:lsmMaxDepth": "2.89 m",
          "ds:lsmLevels": "4",
