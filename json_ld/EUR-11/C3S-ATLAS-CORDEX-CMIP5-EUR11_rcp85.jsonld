        "@id": "cx5m:MPI-CSC-REMO2009-EUR-11-v1",
        "@type": "ds:RCM",
        "rdfs:label": "REMO2009",
        "ds:simulationNotes": "The model releases REMO2009 and REMO2015 differ in internal technical aspects related to refactoring and improving the model code. The physical parameterizations and the implementation of the dynamics are the same. REMO2015 v2 refers to a rerun of the corresponding REMO2015 v1 simulation, which was necessary due to inconsistent model level and surface data in CNRM-CM5 GCM boundary conditions.",
        "ds:versionTag": "v1",
        "ds:hasOceanModelComponent": {
          "@id": "#Component.MPI-CSC_REMO2009_v1_OceanModel",
          "@type": "ds:OceanModel",
          "rdfs:label": "MPI-CSC_REMO2009_v1_OceanModel",
          "ds:oceanRepresentationMode": "prescribed SST and SIC "
        },
        "ds:hasLandSurfaceModelComponent": {
          "@id": "#Component.MPI-CSC_REMO2009_v1_LandSurfaceModel",
          "@type": "ds:LandSurfaceModel",
          "rdfs:label": "MPI-CSC_REMO2009_v1_LandSurfaceModel",
          "ds:lsmMisc": "A tile-based scheme including annual cycle of albedo",
          "ds:lsmLevels": "5",
          "ds:lsmComponentName": "Rechid et al. (2009)"
        },
        "ds:hasAerosolModelComponent": {
          "@id": "#Component.MPI-CSC_REMO2009_v1_AerosolModel",
          "@type": "ds:AerosolModel",
          "rdfs:label": "MPI-CSC_REMO2009_v1_AerosolModel",
          "ds:aerosolMisc": "Tanré et al. (1984) climatology",
          "ds:aerosolParameterizationDescription": "prescribed"
        },
        "ds:hasAtmosModelComponent": {
          "@id": "#Component.MPI-CSC_REMO2009_v1_AtmosphericModel",
          "@type": "ds:AtmosModel",
          "rdfs:label": "MPI-CSC_REMO2009_v1_AtmosphericModel",
          "ds:atmosMisc": "hybrid sigma-pressure coordinate system",
          "ds:atmosShortwaveRadiationScheme": "Morcrette et al. (1986) with modifications for additional greenhouse gases, 14.6 μm band of ozone and various types of aerosols. Continuum absorption after Giorgetta and Wild (1995).",
          "ds:atmosLongwaveRadiationScheme": "Morcrette et al. (1986) with modifications for additional greenhouse gases, 14.6 μm band of ozone and various types of aerosols. Continuum absorption after Giorgetta and Wild (1995).",
          "ds:atmosConvectionScheme": "Mass flux (Tiedtke, 1989) with modifications after Nordeng (1994) and Pfeifer (2006)",
          "ds:atmosDynamicsCore": "Hydrostatic model built on German Weather Service (DWD) Europa–Modell (EM) weather prediction model dynamics (Majewski, 1991) and ECHAM physics (Roeckner et. al., 1996)."
