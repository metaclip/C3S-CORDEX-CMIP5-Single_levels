            "@id": "ipcc:IPSL-CM5A-MR"
          },
          {
            "@id": "ipcc:EC-EARTH"
          }
        ],
        "ds:hasOceanModelComponent": {
          "@id": "#Component.KNMI_RACMO22E_v1_OceanModel",
          "@type": "ds:OceanModel",
          "rdfs:label": "KNMI_RACMO22E_v1_OceanModel",
          "ds:oceanRepresentationMode": "prescribed SST and SI concentration; inferred from from reanalysis or GCM"
        },
        "ds:hasLandSurfaceModelComponent": {
          "@id": "#Component.KNMI_RACMO22E_v1_LandSurfaceModel",
          "@type": "ds:LandSurfaceModel",
          "rdfs:label": "KNMI_RACMO22E_v1_LandSurfaceModel",
          "ds:lsmMaxDepth": "2.89 m",
          "ds:lsmLevels": "4",
          "ds:lsmComponentName": "HTESSEL (Balsamo et al., 2009)"
        },
        "ds:hasAerosolModelComponent": {
          "@id": "#Component.KNMI_RACMO22E_v1_AerosolModel",
          "@type": "ds:AerosolModel",
          "rdfs:label": "KNMI_RACMO22E_v1_AerosolModel",
          "ds:aerosolMisc": "inferred from CAM inventory (except volcanic); historical and RCP pathways (van Vuuren et al., 2011; Lamarque et al., 2010; 2011); also used in evaluation Sulfate, particulate organic matter black carbon, sea salt, desert dust stratospheric aerosols, volcanic aerosol. Spatial maps and vertical profiles per species. Monthly variations and decadal trends. ",
          "ds:aerosolParameterizationDescription": "prescribed"
        },
        "ds:hasAtmosModelComponent": {
          "@id": "#Component.KNMI_RACMO22E_v1_AtmosphericModel",
          "@type": "ds:AtmosModel",
          "rdfs:label": "KNMI_RACMO22E_v1_AtmosphericModel",
          "ds:atmosMisc": "Baseline physics is taken from the IFS CY31r1 ECMWF package of physical parameterizations. MODIS inferred leaf-area index.",
          "ds:atmosMicrophysicsScheme": " Neggers (2009)",
          "ds:atmosPblScheme": "TKE (Lenderink and Holtslag, 2004)",
          "ds:atmosConvectionScheme": "EDMF-scheme (Siebesma et al., 2007). shCU: Neggers et al. (2009)",
          "ds:atmosDynamicsCore": "Hydrostatic, with HIRLAM dynamical kernel (Undén et al. 2002) utilizing a 2-level semi-lagrangian advection scheme.",
          "ds:toaLevels": "40"
        },
        "ds:wasDevelopedBy": {
          "@id": "ipcc:KNMI"
        }
      },
